{
  "name": "cloud_matomo",
  "version": "1.0.0",
  "description": "Track Nextcloud users with matomo",
  "repository": {
    "type": "git",
    "url": "https://github.com/arawa/cloud_matomo.git"
  },
  "type": "module",
  "keywords": [
    "nextcloud",
    "matomo",
    "tracking"
  ],
  "author": "Klaus Herberth <klaus@jsxc.org>",
  "contributors": [
    {
      "name": "Klaus Herberth",
      "email": "klaus@jsxc.org"
    },
    {
      "name": "Sébastien Marinier",
      "email": "sebastien.marinier@arawa.fr"
    },
    {
      "name": "Baptiste Fotia",
      "email": "baptiste.fotia@arawa.fr"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/arawa/cloud_matomo/issues"
  },
  "homepage": "https://github.com/arawa/cloud_matomo",
  "scripts": {
    "release:build": "grunt build:release",
    "release:sign": "grunt sign:release",
    "release:publish": "node scripts/publish-release.js",
    "build": "vite --mode production build",
    "dev": "vite --mode development build",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint \"src/**/*.{js,ts,vue}\"",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint  --fix",
    "stylelint": "stylelint src/**/*.scss src/**/*.vue",
    "stylelint:fix": "stylelint src/**/*.scss src/**/*.vue --fix",
    "watch": "vite --mode development build --watch"
  },
  "dependencies": {
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "^2.5.2",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.0",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/vue": "^9.8.0",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@nextcloud/eslint-config": "^8.4.2",
    "@nextcloud/vite-config": "^2.5.0",
    "@octokit/rest": "^22.0.1",
    "@vue/tsconfig": "^0.9.1",
    "colors": "^1.4.0",
    "dotenv": "^8.2.0",
    "execa": "^4.0.3",
    "grunt": "^1.0.4",
    "grunt-banner": "^0.6.0",
    "grunt-cli": "^1.3.2",
    "grunt-contrib-clean": "^2.0.0",
    "grunt-contrib-compress": "^1.5.0",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-contrib-jshint": "^3.2.0",
    "grunt-contrib-uglify": "^4.0.1",
    "grunt-exec": "^3.0.0",
    "grunt-jsbeautifier": "^0.2.13",
    "grunt-text-replace": "^0.4.0",
    "inquirer": "^13.2.0",
    "simple-git": "^3.30.0",
    "vite": "^7.1.6"
  },
  "engines": {
    "node": "^22.0.0",
    "npm": "^10.5.1"
  }
}
